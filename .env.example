# Telegram Bot API token from @BotFather.
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org.
API_ID=
API_HASH=

# Comma-separated Telegram user IDs allowed to control the bot.
ADMIN_IDS=

# Optional: send reports to a group/chat instead of the first ADMIN_IDS entry.
# Use /chat_id in the target chat to get this value.
# REPORT_CHAT_ID=

# Optional legacy target channel setting. Reports are controlled by REPORT_CHAT_ID.
TARGET_CHANNEL=

# Collection run settings.
POST_LIMIT=30
SCHEDULE_TIME=06:00
SESSION_NAME=aggregator_session

# Optional: force active collection without editing collections.json.
# ACTIVE_COLLECTION=

# Optional: path to local collections file. The file is ignored by Git.
COLLECTIONS_PATH=collections.json

# Optional: store collections directly in an environment/GitHub Secret as one-line JSON.
# If set, this takes priority over COLLECTIONS_PATH.
# COLLECTIONS_JSON={"collections":{"example":["@telegram","@durov"]},"active":"example"}
